		   /********Temporary fix to disable Alt + <-/->/Bkspace for weblogic (Chrome only) ************/

			   function cancelBack(){
					var evtobj = window.event ? event : e;
					var unicode = evtobj.charCode ? e.charCode : evtobj.keyCode;
					if (unicode == 37 && evtobj.altKey || 
						unicode == 39 && evtobj.altKey
					   )
					{
						evtobj.cancelBubble = true;
						evtobj.returnValue = false;
						return false;
						evtobj.preventDefault();
					}
					return true;
				}  

				$(document).ready(function(){
					$('body').on('keydown', cancelBack)
				});

